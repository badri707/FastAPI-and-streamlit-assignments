# Social Eagle Community Manager — local configuration. Copy to .env (scripts/setup does this).
# Placeholders only. Never put real secrets in this file or in Git.

# evaluation = synthetic data + local simulator (default). Live mode is not implemented in this phase.
RUN_MODE=evaluation
LIVE_CONNECTION_AUTHORIZED=false

# Loopback only. Remote access/public hosting is disabled in this phase.
HOST=127.0.0.1
PORT=8787

# Keep the database on the internal disk by default.
# DATA_DIR=/absolute/path/to/data
# Optional: verified external SSD path for backups/archives (the app never requires it to start).
# EXTERNAL_SSD_PATH=/Volumes/YourSSD/social-eagle
# BACKUP_DIR=/Volumes/YourSSD/social-eagle/backups

# Local AI via Ollama (free, runs on this machine). No cloud provider is configured.
AI_PROVIDER=ollama
OLLAMA_URL=http://127.0.0.1:11434
# Recommended on an 8 GB Mac: Qwen3 4B Instruct 2507 (Apache-2.0), Q4_K_M quantization.
# Verify the exact tag with `ollama pull`; see docs/AI_MODEL.md for the import-from-GGUF alternative.
OLLAMA_MODEL=qwen3:4b-instruct-2507-q4_K_M
# Optional embedding model for hybrid retrieval (Apache-2.0, ~270 MB). Without it, keyword-only retrieval is used.
OLLAMA_EMBED_MODEL=nomic-embed-text
AI_NUM_CTX=4096
AI_TIMEOUT_S=180
